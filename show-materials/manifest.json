{
  "manifest_version": 3,
  "name": "Fabric Composition Inspector",
  "version": "2.1",
  "description": "Automatically extracts fabric & material composition across major clothing retailers.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon16.png"
    },
    "default_title": "Fabric Composition Inspector"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.macys.com/*",
    "*://*.ae.com/*",
    "*://*.aeropostale.com/*",
    "*://*.hottopic.com/*",
    "*://*.target.com/*",
    "*://*.walmart.com/*",
    "*://*.gap.com/*",
    "*://*.oldnavy.gap.com/*",
    "*://*.bananarepublic.gap.com/*",
    "*://*.nordstrom.com/*",
    "*://*.zara.com/*",
    "*://*.shein.com/*",
    "*://*.asos.com/*",
    "*://*.jcrew.com/*",
    "*://*.uniqlo.com/*",
    "*://*.hm.com/*",
    "*://*.urbanoutfitters.com/*",
    "*://*.hollisterco.com/*",
    "*://*.abercrombie.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.macys.com/*",
        "*://*.ae.com/*",
        "*://*.aeropostale.com/*",
        "*://*.hottopic.com/*",
        "*://*.target.com/*",
        "*://*.walmart.com/*",
        "*://*.gap.com/*",
        "*://*.oldnavy.gap.com/*",
        "*://*.bananarepublic.gap.com/*",
        "*://*.nordstrom.com/*",
        "*://*.zara.com/*",
        "*://*.shein.com/*",
        "*://*.asos.com/*",
        "*://*.jcrew.com/*",
        "*://*.uniqlo.com/*",
        "*://*.hm.com/*",
        "*://*.urbanoutfitters.com/*",
        "*://*.hollisterco.com/*",
        "*://*.abercrombie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": [
        "*://*.amazon.com/*",
        "*://*.macys.com/*",
        "*://*.ae.com/*",
        "*://*.aeropostale.com/*",
        "*://*.hottopic.com/*",
        "*://*.target.com/*",
        "*://*.walmart.com/*",
        "*://*.gap.com/*",
        "*://*.oldnavy.gap.com/*",
        "*://*.bananarepublic.gap.com/*",
        "*://*.nordstrom.com/*",
        "*://*.zara.com/*",
        "*://*.shein.com/*",
        "*://*.asos.com/*",
        "*://*.jcrew.com/*",
        "*://*.uniqlo.com/*",
        "*://*.hm.com/*",
        "*://*.urbanoutfitters.com/*",
        "*://*.hollisterco.com/*",
        "*://*.abercrombie.com/*"
      ]
    }
  ]
}
